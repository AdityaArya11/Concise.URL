PORT=4000
NODE_ENV=development

# 'memory' for zero-setup local dev, 'mongo' for production (MongoDB Atlas etc.)
DB_MODE=memory
MONGO_URI=mongodb://localhost:27017/concise

# 'memory' for zero-setup local dev, 'redis' for production
CACHE_MODE=redis
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

APP_BASE_URL=http://localhost:4000
